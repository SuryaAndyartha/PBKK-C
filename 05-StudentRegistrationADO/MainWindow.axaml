<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:StudentRegistration.Models"
        x:Class="StudentRegistration.MainWindow"
        Title="Student Registration"
        Width="1100"
        Height="500">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">

        <StackPanel Orientation="Horizontal"
                    Spacing="30"
                    Margin="0,0,0,15">
            <TextBlock Text="Student Registration"
                       FontSize="26"
                       FontWeight="Bold" />
            <Button Content="Refresh"
                    Width="100"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Center"
                    Click="RefreshButton_Click" />
            <TextBlock x:Name="TotalTextBlock"
                       VerticalAlignment="Center"
                       FontSize="16" />
        </StackPanel>

        <DataGrid x:Name="StudentDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  BorderBrush="#808080"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="models:Student" Header="ID" Binding="{Binding StudentId}" Width="60" />
                <DataGridTextColumn x:DataType="models:Student" Header="NIM" Binding="{Binding NIM}" Width="100" />
                <DataGridTextColumn x:DataType="models:Student" Header="Nama" Binding="{Binding Name}" Width="160" />
                <DataGridTextColumn x:DataType="models:Student" Header="Program Studi" Binding="{Binding ProgramName}" Width="170" />
                <DataGridTextColumn x:DataType="models:Student" Header="Tanggal Lahir" Binding="{Binding BirthDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120" />
                <DataGridTextColumn x:DataType="models:Student" Header="No. Telepon" Binding="{Binding PhoneNumber}" Width="130" />
                <DataGridTextColumn x:DataType="models:Student" Header="Alamat" Binding="{Binding Address}" Width="*" />
                <DataGridTextColumn x:DataType="models:Student" Header="Dibuat" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   Foreground="#C62828"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
